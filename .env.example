# Copy to .env and adjust. Every value has a working default; nothing here is required.

# Corpus scope (PRD OQ3): criminal law, first half of March, three years.
RAG_DATE_WINDOWS=2023-03-01:2023-03-15,2024-03-01:2024-03-15,2025-03-01:2025-03-15

# Chunking: MiniLM embeds 128 tokens (~450 chars); size ≈ window + overlap so nothing is lost.
RAG_CHUNK_SIZE=560
RAG_CHUNK_OVERLAP=120

# Retrieval: hybrid cosine + BM25 candidates, cross-encoder rerank of the top RAG_RERANK_TOP,
# then the no-source threshold on the reranker's relevance probability (0–1).
RAG_TOP_K=6
RAG_RERANK_TOP=12
RAG_RERANKER=jinaai/jina-reranker-v2-base-multilingual   # or: none (threshold then applies to cosine)
RAG_SCORE_THRESHOLD=0.35

# Embeddings: fastembed | ollama | fake
RAG_EMBEDDER=fastembed
RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Generation: ollama | anthropic | extractive | fake
RAG_LLM=ollama
RAG_OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=
RAG_ANTHROPIC_MODEL=claude-sonnet-5
