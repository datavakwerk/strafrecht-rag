<mxGraphModel dx="1300" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="820" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Geen bron, geen antwoord — afgedwongen in code" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="De regel is geen instructie in de prompt waar het model zich aan mag houden. Elke bewering wordt ná de generatie gecontroleerd tegen de passages die daadwerkelijk zijn aangeleverd." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/></mxCell>
<mxCell id="g1" value="1 · RETRIEVAL&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;beste relevantie onder de drempel&lt;br&gt;→ het taalmodel wordt niet aangeroepen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="g2" value="2 · GENERATIE&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;genummerde passages · één bewering per regel&lt;br&gt;[n]-markers verplicht · GEEN_BRON toegestaan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="g3" value="3 · VERIFICATIE&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;markers moeten naar aangeleverde passages wijzen&lt;br&gt;een onbekende ECLI keurt de bewering af&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="chain" value="ÉÉN BEWERING DOOR DE CONTROLE" style="swimlane;rounded=1;fillColor=#fafafa;strokeColor=#cccccc;fontStyle=1;fontSize=12;startSize=30;html=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="800" height="500" as="geometry"/></mxCell>
<mxCell id="c0" value="regel uit de ruwe output&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;bullets en nummering worden gestript&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="chain"><mxGeometry x="20" y="42" width="330" height="54" as="geometry"/></mxCell>
<mxCell id="c1" value="staat er een [n]-marker?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="chain"><mxGeometry x="40" y="112" width="290" height="62" as="geometry"/></mxCell>
<mxCell id="c2" value="wijst hij naar een aangeleverde passage?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="chain"><mxGeometry x="40" y="190" width="290" height="62" as="geometry"/></mxCell>
<mxCell id="c3" value="alle genoemde ECLI's uit de passages?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="chain"><mxGeometry x="40" y="268" width="290" height="62" as="geometry"/></mxCell>
<mxCell id="c4" value="al eerder gezegd?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="chain"><mxGeometry x="40" y="346" width="290" height="62" as="geometry"/></mxCell>
<mxCell id="c5" value="GEACCEPTEERD&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;bewering + verwijzing:&lt;br&gt;ECLI · §4.2 Waardering van het bewijs › Het oordeel van de rechtbank · par. 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="chain"><mxGeometry x="20" y="424" width="330" height="62" as="geometry"/></mxCell>
<mxCell id="r1" value="afgekeurd — &quot;geen verwijzing naar een passage&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#9a3b37;" vertex="1" parent="chain"><mxGeometry x="440" y="118" width="330" height="50" as="geometry"/></mxCell>
<mxCell id="r2" value="afgekeurd — &quot;verwijzing naar niet-aangeleverde passage&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#9a3b37;" vertex="1" parent="chain"><mxGeometry x="440" y="196" width="330" height="50" as="geometry"/></mxCell>
<mxCell id="r3" value="afgekeurd — &quot;ECLI niet in de passages&quot;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;het klassieke verzonnen zaaknummer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontColor=#9a3b37;" vertex="1" parent="chain"><mxGeometry x="440" y="270" width="330" height="58" as="geometry"/></mxCell>
<mxCell id="r4" value="samengevoegd met de eerdere bewering&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;kleine modellen herhalen zichzelf; verwijzingen worden samengevoegd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#7a5c00;" vertex="1" parent="chain"><mxGeometry x="440" y="348" width="330" height="58" as="geometry"/></mxCell>
<mxCell id="side1" value="ALS ER NIETS OVERLEEFT&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;één retry met een format-herinnering.&lt;br&gt;Beide pogingen blijven in de ruwe output staan,&lt;br&gt;zodat --json en de evaluatie laten zien&lt;br&gt;wat er werkelijk gebeurd is.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="1"><mxGeometry x="880" y="190" width="400" height="130" as="geometry"/></mxCell>
<mxCell id="side2" value="TWEE MANIEREN OM &quot;GEEN BRON&quot; TE ZEGGEN&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;1 · de beste relevantie haalt de drempel niet —&lt;br&gt;het taalmodel wordt niet aangeroepen&lt;br&gt;&lt;br&gt;2 · het model antwoordt zelf GEEN_BRON&lt;br&gt;&lt;br&gt;Beide worden gerapporteerd, mét reden en score.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="880" y="340" width="400" height="160" as="geometry"/></mxCell>
<mxCell id="side3" value="EN HET WORDT GETEST&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;De testsuite bevat een nep-LLM die een ECLI verzint&lt;br&gt;en één die de verwijzingen weglaat. Allebei worden&lt;br&gt;afgekeurd. De evaluatieset bevat vragen die de&lt;br&gt;geen-bron-route móéten raken, zodat die route&lt;br&gt;gemeten wordt in plaats van aangenomen.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="1"><mxGeometry x="880" y="520" width="400" height="170" as="geometry"/></mxCell>
<mxCell id="foot" value="Bronjuistheid is 100% per constructie: een bewering met een onbekende ECLI of zonder verwijzing haalt het antwoord nooit. Het interessante getal is claimacceptatie (89%) — dat laat zien hoe vaak het model wél van de passages af zou zijn gelopen." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1240" height="50" as="geometry"/></mxCell>
