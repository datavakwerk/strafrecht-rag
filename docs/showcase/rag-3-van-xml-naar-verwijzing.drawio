<mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="760" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Van XML naar een verwijzing die je kunt nalopen" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Een verwijzing is pas bruikbaar als hij naar een plek in de uitspraak wijst. Daarom draagt elke chunk zijn ECLI, sectie en paragraafbereik met zich mee — van parser tot antwoord." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/></mxCell>
<mxCell id="xml" value="XML VAN RECHTSPRAAK.NL" style="swimlane;rounded=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="360" height="440" as="geometry"/></mxCell>
<mxCell id="x1" value="&amp;lt;section&amp;gt; 4 Waardering van het bewijs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="xml"><mxGeometry x="20" y="42" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="x2" value="&lt;b&gt;Standpunt van de verdediging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;een losse vetgedrukte alinea — geen eigen tag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="xml"><mxGeometry x="40" y="92" width="300" height="46" as="geometry"/></mxCell>
<mxCell id="x3" value="alinea · alinea · alinea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=10;fontColor=#777777;" vertex="1" parent="xml"><mxGeometry x="40" y="146" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="x4" value="&lt;b&gt;Het oordeel van de rechtbank&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;idem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="xml"><mxGeometry x="40" y="190" width="300" height="42" as="geometry"/></mxCell>
<mxCell id="x5" value="alinea · alinea · alinea · alinea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=10;fontColor=#777777;" vertex="1" parent="xml"><mxGeometry x="40" y="240" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="x6" value="&amp;lt;section&amp;gt; 5 Strafbaarheid van het feit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="xml"><mxGeometry x="20" y="286" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="xnote" value="Het schema verschilt per jaar en per instantie. De parser matcht op lokale namen, is namespace-agnostisch en wordt getest op opgenomen uitspraken van zowel een rechtbank als een hof — zo blijven de eigenaardigheden in één module zitten." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontStyle=2;spacingLeft=6;" vertex="1" parent="xml"><mxGeometry x="20" y="336" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="mod" value="MODEL — één genormaliseerde Uitspraak" style="swimlane;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="380" height="440" as="geometry"/></mxCell>
<mxCell id="m1" value="metadata&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;ECLI · instantie · datum · rechtsgebieden&lt;br&gt;procedures · zaaknummer · wetsverwijzingen&lt;br&gt;samenvatting · soort (uitspraak/conclusie)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="mod"><mxGeometry x="20" y="42" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="m2" value="Sectie 4.1 — Standpunt van de verdediging&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Paragraaf 1 · 2 · 3 (genummerd, geordend)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="mod"><mxGeometry x="20" y="126" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="m3" value="Sectie 4.2 — Het oordeel van de rechtbank&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Paragraaf 1 · 2 · 3 · 4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="mod"><mxGeometry x="20" y="196" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="m4" value="Sectie 5 — Strafbaarheid van het feit&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Paragraaf 1 · 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="mod"><mxGeometry x="20" y="266" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="mnote" value="De vette kopjes zijn subsecties geworden. Uitspraken zetten &quot;Standpunt van de verdediging&quot; en &quot;Het oordeel van de rechtbank&quot; vet in plaats van in aparte tags — splitsen maakt zowel de verwijzing als de embedding preciezer." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#3b5a86;fontStyle=2;spacingLeft=6;" vertex="1" parent="mod"><mxGeometry x="20" y="336" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="ch" value="CHUNKS — 560 tekens, 120 overlap" style="swimlane;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="400" height="440" as="geometry"/></mxCell>
<mxCell id="h1" value="ECLI…#11 · sectie 4.2 · par. 1–3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="ch"><mxGeometry x="20" y="42" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="h2" value="ECLI…#12 · sectie 4.2 · par. 3–4&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;paragraaf 3 zit in allebei: de overlap loopt in hele paragrafen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=3;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="ch"><mxGeometry x="20" y="90" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="h3" value="ECLI…#13 · sectie 5 · par. 1–2&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;nieuwe sectie = nieuwe chunk, altijd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="ch"><mxGeometry x="20" y="154" width="360" height="52" as="geometry"/></mxCell>
<mxCell id="h4" value="de verwijzing die de gebruiker ziet&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;ECLI:NL:RBNNE:2024:674, sectie 4.2&lt;br&gt;(Waardering van het bewijs › Het oordeel&lt;br&gt;van de rechtbank), par. 3–4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="ch"><mxGeometry x="20" y="222" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="hnote" value="Waarom 560/120: de embedder ziet hooguit 128 tokens (~450 tekens). Een chunk van venster + overlap zorgt dat het stuk dat buiten het venster valt als begin van de volgende chunk wél wordt geëmbed. BM25 ziet sowieso elk teken." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#3d6b2e;fontStyle=2;spacingLeft=6;" vertex="1" parent="ch"><mxGeometry x="20" y="332" width="360" height="94" as="geometry"/></mxCell>
<mxCell id="f1" value="parser" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#555555;strokeWidth=3;endArrow=block;fontSize=11;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="xml" target="mod"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" value="chunker" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#555555;strokeWidth=3;endArrow=block;fontSize=11;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="mod" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="foot" value="&lt;b&gt;chunk_id = &quot;&amp;lt;ECLI&amp;gt;#positie&quot;&lt;/b&gt; — stabiel over runs heen, dus opnieuw indexeren is een upsert en geen duplicaat. De chunker is een pure functie: dezelfde uitspraak levert altijd dezelfde chunks, wat hem testbaar maakt zonder model, zonder database en zonder netwerk." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1240" height="60" as="geometry"/></mxCell>
<mxCell id="foot2" value="Zonder deze structuur zou een antwoord kunnen verwijzen naar &quot;een uitspraak van de rechtbank Noord-Nederland&quot;. Met deze structuur verwijst het naar de alinea waar het vandaan komt — en dat is het verschil tussen iets dat overtuigend klinkt en iets dat controleerbaar is." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1240" height="60" as="geometry"/></mxCell>
</root></mxGraphModel>
