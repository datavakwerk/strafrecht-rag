<mxCell id="title" value="strafrecht-rag — architectuur" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Twee ketens: offline bouwt het corpus (ingest → parse → chunk → embed → store), online beantwoordt een vraag (retrieve → herrangschik → drempel → LLM → verifieer). Alles draait lokaal." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/></mxCell>
<mxCell id="off" value="OFFLINE — het corpus bouwen" style="swimlane;rounded=1;fillColor=#fafafa;strokeColor=#cccccc;fontStyle=1;fontSize=12;startSize=30;html=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1380" height="300" as="geometry"/></mxCell>
<mxCell id="o1" value="Rechtspraak.nl Open Data&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;zoekfeed + content&lt;br&gt;open access, geen sleutel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="off"><mxGeometry x="20" y="44" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="o2" value="ingest/client.py&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;pagineert op datum + rechtsgebied&lt;br&gt;rate limited · retries met backoff&lt;br&gt;hervatbaar: bestaande bestanden&lt;br&gt;worden overgeslagen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="off"><mxGeometry x="240" y="44" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="o3" value="data/raw/&amp;lt;ECLI&amp;gt;.xml&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;1.906 uitspraken&lt;br&gt;niet in git&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#8c8c8c;fontSize=11;fontStyle=1;" vertex="1" parent="off"><mxGeometry x="470" y="44" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="o4" value="ingest/parser.py&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;XML → Uitspraak&lt;br&gt;secties + genummerde paragrafen&lt;br&gt;vette kopjes worden subsecties&lt;br&gt;&lt;br&gt;één stuk bestand = één foutrecord,&lt;br&gt;nooit een gecrashte batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="off"><mxGeometry x="670" y="44" width="210" height="110" as="geometry"/></mxCell>
<mxCell id="o5" value="index/chunker.py&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;560 tekens, 120 overlap&lt;br&gt;nooit over een sectiegrens&lt;br&gt;overlap in hele paragrafen&lt;br&gt;&lt;br&gt;puur en deterministisch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="off"><mxGeometry x="910" y="44" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="o6" value="index/embeddings.py&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;multilingual MiniLM, 384d&lt;br&gt;ONNX, gekwantiseerd, lokaal&lt;br&gt;~13 chunks/s op een laptop-CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="off"><mxGeometry x="1140" y="44" width="215" height="110" as="geometry"/></mxCell>
<mxCell id="onote" value="Herindexeren slaat ongewijzigde uitspraken over via een content-fingerprint per ECLI; chunk_id = &quot;&amp;lt;ECLI&amp;gt;#positie&quot;, dus elke schrijfactie is een upsert." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="off"><mxGeometry x="240" y="180" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="o7" value="Corpus: strafrecht, 1–15 maart 2023 · 2024 · 2025 — 1.906 uitspraken, 0 parse-fouten, 124.952 chunks, 22 instanties" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#444444;fontStyle=1;" vertex="1" parent="off"><mxGeometry x="240" y="220" width="1115" height="30" as="geometry"/></mxCell>
<mxCell id="store" value="index/store.py — SQLite + NumPy&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;metadata in tabellen · BM25 via FTS5 · vectoren als één float32-matrix&lt;br&gt;exacte cosine-scan in enkele milliseconden · één bestand, geen service · 473 MB&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="520" height="110" as="geometry"/></mxCell>
<mxCell id="on" value="ONLINE — een vraag beantwoorden" style="swimlane;rounded=1;fillColor=#fafafa;strokeColor=#cccccc;fontStyle=1;fontSize=12;startSize=30;html=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1380" height="270" as="geometry"/></mxCell>
<mxCell id="q1" value="vraag&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;+ filters: instantietype,&lt;br&gt;instantie, datumbereik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="on"><mxGeometry x="20" y="60" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="q2" value="retriever&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;cosine top-3k ⊕ BM25 top-3k&lt;br&gt;samengevoegd met RRF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="on"><mxGeometry x="200" y="60" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="q3" value="cross-encoder&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;herrangschikt de top-12&lt;br&gt;gekalibreerde relevantie 0–1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="on"><mxGeometry x="420" y="60" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="q4" value="drempel 0,35" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="on"><mxGeometry x="640" y="55" width="150" height="100" as="geometry"/></mxCell>
<mxCell id="q5" value="LLM&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;ollama (standaard) · Anthropic&lt;br&gt;of extractief, zonder model&lt;br&gt;&lt;br&gt;krijgt genummerde passages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="on"><mxGeometry x="830" y="60" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="q6" value="verify&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;markers → aangeleverde passages&lt;br&gt;ECLI moet erbij horen&lt;br&gt;in code, niet in de prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="on"><mxGeometry x="1050" y="60" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="q7" value="Antwoord&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;beweringen +&lt;br&gt;verwijzingen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="on"><mxGeometry x="1270" y="60" width="90" height="90" as="geometry"/></mxCell>
<mxCell id="q8" value="GEEN BRON&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;het taalmodel wordt niet eens aangeroepen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="on"><mxGeometry x="620" y="185" width="190" height="60" as="geometry"/></mxCell>
